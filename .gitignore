.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/

# Interner Datenspeicher (bereinigte Ticket-Daten für Phase 2/3) - kann
# groß werden und ist generiert, nicht Quellcode.
data/

# Echte Jira-Exporte und generierte Tickets/Dokumente bleiben lokal,
# nur die Ordnerstruktur (.gitkeep) wird versioniert.
Input/*
!Input/.gitkeep
Output/*/*
!Output/*/.gitkeep

# Gebaute Web-App mit eingebetteten (echten) Ticketdaten - nicht versionieren.
webapp/ticket_cockpit.build.html

# JS-Test-Abhängigkeiten (npm install in webapp/tests/) - nicht versionieren.
webapp/tests/node_modules/

# Von run-all.js bei jedem Testlauf neu geschriebener Bericht - generiert,
# wird von build-webapp gelesen und in ticket_cockpit.build.html eingebettet
# (die ebenfalls nicht versioniert wird), nicht selbst Quellcode.
webapp/tests/test-results.json
